# 판정 임계값 파일 (ml 쪽 E2 결과로 생성)
THRESHOLDS_PATH=models/thresholds.json

# 업로드 제한 (bytes)
MAX_UPLOAD_BYTES=10485760

# 실험용 v2 API — 둘 다 설정해야 로드한다. 기존 NMS 임계값은 사용 불가.
# DENSE_WEIGHTS_PATH=models/e1.pt
# DENSE_BUNDLE_PATH=models/dense-bundle.json
DENSE_DEVICE=cpu

# 웹 앱 시연용 CORS 허용 출처 (쉼표로 여러 개). 비워 두면 CORS 를 붙이지 않는다.
# CORS_ORIGINS=http://localhost:5555
